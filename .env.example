# Local CMS
PAYLOAD_SERVER_URL=http://localhost:3101
WEBSITE_URL=http://localhost:3001
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# SQLite is intended for local development only.
PAYLOAD_DB_PROVIDER=sqlite
PAYLOAD_SQLITE_URL=file:./.data/payload.db
PAYLOAD_DB_PUSH=true

# Optional website integration. Configure both members of each pair together.
WEBSITE_PREVIEW_SECRET=
WEBSITE_REVALIDATE_URL=http://localhost:3001/api/revalidate
WEBSITE_REVALIDATE_SECRET=

# Optional email delivery for password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sigmacore.id
SMTP_FROM_NAME=Sigma Core CMS
