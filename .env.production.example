APP_VERSION=replace-with-git-commit
CMS_HTTP_PORT=3101

PAYLOAD_SERVER_URL=https://cms.sigmacore.id
WEBSITE_URL=https://sigmacore.id
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PAYLOAD_DB_PROVIDER=postgres
PAYLOAD_DB_PUSH=false
DATABASE_URL=postgresql://scs:replace-with-database-password@postgres:5432/scs_cms
CORE_DATABASE_URL=postgresql://scs:replace-with-database-password@scs-company-profile-postgres-1:5432/scs_core

WEBSITE_PREVIEW_SECRET=replace-with-a-different-random-secret
WEBSITE_REVALIDATE_URL=https://sigmacore.id/api/revalidate
WEBSITE_REVALIDATE_SECRET=replace-with-a-different-random-secret

SMTP_HOST=mail.sigmacore.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@sigmacore.id
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@sigmacore.id
SMTP_FROM_NAME=Sigma Core CMS

# Reuse the current production resources during the repository split.
CMS_BACKEND_NETWORK=scs-company-profile_backend
CMS_MEDIA_VOLUME=scs-company-profile_cms-media
CMS_EDGE_NETWORK=scs-edge

# Temporary, server-local extracted content bundle used by the tools profile.
CMS_IMPORT_BUNDLE_HOST=/opt/scs-company-profile/migrations/testing-content
CMS_IMPORT_MODE=dry-run
CMS_IMPORT_BACKUP_CONFIRMED=

# Only needed when running `pnpm cms:create-admin` inside the CMS container.
# Never store the account password here; the script reads it from stdin.
CMS_ADMIN_NAME=CMS Administrator
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_ROLE=admin
